<selector xmlns:android="http://schemas.android.com/apk/res/android">
 <item android:state_pressed="true"><shape><solid android:color="#B8D5F5"/><stroke android:width="2dp" android:color="#175BA0"/><corners android:radius="4dp"/></shape></item>
 <item android:state_selected="true"><shape><solid android:color="#D7E8FF"/><stroke android:width="2dp" android:color="#175BA0"/><corners android:radius="4dp"/></shape></item>
 <item android:state_focused="true"><shape><solid android:color="#FFFFFF"/><stroke android:width="2dp" android:color="#175BA0"/><corners android:radius="4dp"/></shape></item>
 <item><shape><solid android:color="#F5F5F5"/><stroke android:width="1dp" android:color="#B0B0B0"/><corners android:radius="4dp"/></shape></item>
</selector>
